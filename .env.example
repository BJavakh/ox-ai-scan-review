# Copy to .env and fill in what you need. Everything is optional.

# live = real GitHub + OSV calls, mock = offline fixtures
SCANNER_MODE=live

# API server
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info
# Allowed CORS origin (the web app)
WEB_ORIGIN=http://localhost:5180

# Optional: raises GitHub's rate limit from 60/h to 5,000/h.
# Use a fine-grained token with public-repository read-only access.
GITHUB_TOKEN=

# Optional: enables AI-written summaries. Without it, a template summary is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limits
SCAN_TIMEOUT_MS=120000
LLM_TIMEOUT_MS=20000
SCAN_CONCURRENCY=2
# New scans per client (IPv4 address or IPv6 /64) per hour; protects the shared GitHub quota
SCANS_PER_HOUR=30

# Deployment (the Docker image sets these itself)
# Reverse proxies in front of the API; 1 behind a single load balancer (Render), 0 locally
TRUST_PROXY_HOPS=0
# Absolute path of the built web app; when set, the API serves it on the same origin
# WEB_DIST_DIR=/app/apps/web/dist
